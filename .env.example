# LugAI 환경변수 예시 — 실제 값은 .env.local에 넣으세요(이 파일은 커밋됨, 값 비움).

# Supabase (클라이언트 공개용)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# 서버 전용 시크릿 — EXPO_PUBLIC_ 금지. 운영은 Supabase Edge Function 시크릿 사용.
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=

# (선택) 크래시 리포팅 — 설정 시에만 Sentry 활성화(프로덕션 빌드)
EXPO_PUBLIC_SENTRY_DSN=
